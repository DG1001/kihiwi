# Einstellungen fuer den Jitsi-Waechter (./dienste.sh jitsi auto start).
# Kopieren nach zustand/jitsi.env und anpassen -- zustand/ ist nicht im Repo.
#
# Adresse des Jitsi-Servers (ohne Raum)
KIHIWI_JITSI_URL=https://meet.example.org
# Konto, dessen Konferenzen Kiwi betritt
KIHIWI_JITSI_NUTZER=vorname
# Befehl, der die laufenden Konferenzen als JSON ausgibt, z. B. ueber SSH vom
# Jitsi-Server (Prosody-Modul, das Raum und Eroeffner festhaelt):
KIHIWI_JITSI_RAEUME='ssh jitsi-host docker exec jitsi-prosody-1 curl -s -H "Host: meet.jitsi" http://localhost:5280/kiwi_raeume/raeume'
# Optional
#KIHIWI_JITSI_NAME=Kiwi
#KIHIWI_JITSI_TAKT=10
#KIHIWI_JITSI_WARTEN=180
