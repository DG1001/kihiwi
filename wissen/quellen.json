{
  "_hinweis": "Quellen des Laborwissens. 'aktiv': false schaltet eine Quelle ab, ohne sie zu löschen.",
  "quellen": [
    {
      "name": "kihiwi",
      "art": "lokal",
      "aktiv": true,
      "pfad": "~/Developer/github.com/kihiwi",
      "muster": [
        "*.md"
      ],
      "aus": [
        "aufnahmen",
        "logs",
        ".venv",
        "wissen"
      ]
    },
    {
      "name": "protokolle",
      "art": "lokal",
      "aktiv": true,
      "_hinweis": "Die eigenen Laborprotokolle. Entstehen aus './dienste.sh protokoll'; eine frische Aufnahme ist erst danach auffindbar.",
      "pfad": "~/Developer/github.com/kihiwi/aufnahmen",
      "muster": [
        "protokoll.md"
      ]
    },
    {
      "name": "haupt-repo",
      "art": "git",
      "aktiv": true,
      "url": "https://github.com/BEISPIEL/mein-repo.git",
      "web": "https://github.com/BEISPIEL/mein-repo",
      "muster": [
        "*.md",
        "*.txt",
        "*.pdf",
        "*.csv",
        "*.py",
        "*.json",
        "*.yaml",
        "*.yml"
      ]
    },
    {
      "name": "nextcloud",
      "art": "nextcloud",
      "aktiv": false,
      "_todo": "URL und Nutzer eintragen, App-Passwort in $KIHIWI_NC_PASS ablegen, dann aktiv:true.",
      "url": "https://BEISPIEL/remote.php/dav/files/NUTZER/Labor",
      "nutzer": "NUTZER",
      "passwort_env": "KIHIWI_NC_PASS"
    }
  ]
}
